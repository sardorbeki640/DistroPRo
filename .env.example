# Required for production. Generate a random key and keep it stable across restarts.
# It signs sessions and encrypts saved integration credentials; changing it later breaks decryption.
# Example generator: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# Required only when bootstrapping an empty production database.
OWNER_EMAIL=""
OWNER_LOGIN=""
OWNER_PASSWORD=""

# Optional: enables Gemini-backed AI features. Other app features work without it.
GEMINI_API_KEY=""

# Optional cloud database. TIDB_DATABASE_URL takes precedence over Neon, then Turso.
TIDB_DATABASE_URL=""
NEON_DATABASE_URL=""
# Optional external cron authentication for GET /api/cron/neon-ping (Bearer token, 32+ chars).
NEON_PING_TOKEN=""
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
